# Copy this file to .env and fill in real values. Never commit .env to git.

PORT=3000

# Comma-free single origin of your live site, e.g. https://ngethe-advocates.onrender.com
# Use * only while testing locally.
ALLOWED_ORIGIN=*

# Turso database connection. Create a free database at turso.tech (no credit card),
# then run `turso db show <name> --url` and `turso db tokens create <name>` to get these.
# Leave both blank to use a local SQLite file at ./data/ngethe.db for local dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Long random string — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin login
ADMIN_USERNAME=admin
# Generate with: node hash-password.js "yourRealPassword"
ADMIN_PASSWORD_HASH=

# Optional: email notifications when the contact form is submitted.
# Leave blank to disable — the site still works fine without these.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=

# Optional: powers the AI chatbot on the site via the Anthropic API.
# Leave blank to disable — the chatbot falls back to rule-based replies without it.
ANTHROPIC_API_KEY=
